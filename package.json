{
  "name": "orbit-api",
  "version": "1.0.0",
  "description": "API for Orbit platform ecosystem",
  "keywords": [
    "orbit",
    "api"
  ],
  "homepage": "https://github.com/orbit-collective/orbit-api#readme",
  "bugs": {
    "url": "https://github.com/orbit-collective/orbit-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbit-collective/orbit-api.git"
  },
  "license": "MIT",
  "author": "Adiksuu",
  "type": "module",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "private": "true",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "netlify functions:serve",
    "dev:netlify": "netlify dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "@netlify/functions": "^6.0.0",
    "jose": "^6.2.12",
    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "netlify-cli": "^27.8.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
